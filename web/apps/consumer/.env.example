NEXT_PUBLIC_API_BASE_URL=
API_PROXY_TARGET=
# VAPID public key only. Never put WEBPUSH_VAPID_PRIVATE_KEY here.
NEXT_PUBLIC_WEBPUSH_VAPID_PUBLIC_KEY=
# Turnstile public sitekey only. Never put IDENTITY_HUMAN_CHALLENGE_TURNSTILE_SECRET here.
# Cloudflare visible always-pass test sitekey (dev/tests only): 1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITEKEY=
# Comma-separated Identity AuthOperation values (must match backend IDENTITY_HUMAN_CHALLENGE_OPERATIONS).
NEXT_PUBLIC_TURNSTILE_OPERATIONS=
